# syntax=docker/dockerfile:1
#
# Dockerfile.dev — 开发镜像（dx serve 热重载）
#
# 与生产 Dockerfile 共享相同的镜像源（TUNA/rsproxy/npmmirror/gh-proxy）和工具链
# 安装逻辑。源码通过 COPY 快照 + compose watch 增量 sync 进容器（见
# docker-compose.dev.yml 的 develop.watch 与文件头注释）。
#
# 用法：docker compose -f docker-compose.dev.yml up --build
#
# 容器内布局：
#   /build         ← 镜像内源码快照, 运行时被 compose watch sync 增量覆盖
#   target/        ← named volume（cargo 编译产物，跨重启缓存）
#   libs/node_modules ← named volume（pnpm 虚拟存储，跨重启缓存）

FROM rust:1.97-trixie

# Master switch for Chinese mirrors.
#   CN_MIRROR=false (default): use all upstream/official sources (fast on CI
#     runners outside China).
#   CN_MIRROR=true: route all downloads through Chinese mirrors (TUNA for
#     Debian apt, rsproxy for Rust/crates.io, npmmirror for Node/npm,
#     gh-proxy for GitHub Releases). Pass via: --build-arg CN_MIRROR=true
# Individual mirror URLs are still ARG-overridable for custom mirrors.
ARG CN_MIRROR=false
# Exported as ENV so `make dev` / `make esbuild-cache` / `make wasm-bindgen-cache`
# (called from RUN below) can read it via $$CN_MIRROR in their shell recipes.
ENV CN_MIRROR=${CN_MIRROR}

# ── 镜像源（与生产 Dockerfile 一致）─────────────────────────────
ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
ARG NODE_MIRROR=https://registry.npmmirror.com/-/binary/node
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG RS_PROXY=https://rsproxy.cn
ARG GH_PROXY=https://gh-proxy.com

# --- Debian apt: rewrite sources to the TUNA mirror (CN_MIRROR only). ---
RUN if [ "$CN_MIRROR" = "true" ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
    fi

# ── 系统构建依赖 ─────────────────────────────────────────────────
# 与生产 Dockerfile 相同，但去掉 musl-tools（dev 构建是原生 glibc 目标，
# 不需要 musl 交叉链接）。postgresql-client 方便容器内 psql 调试。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        clang \
        nasm \
        pkg-config \
        libssl-dev \
        binaryen \
        ca-certificates \
        curl \
        gnupg \
        git \
        make \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js 22 + pnpm（与生产 Dockerfile 一致）──────────────────
ARG NODE_VERSION=22.20.0
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64)  NODE_ARCH=x64   ;; \
        arm64)  NODE_ARCH=arm64 ;; \
        *) echo "unsupported arch: $ARCH" >&2; exit 1; \
    esac \
    && if [ "$CN_MIRROR" = "true" ]; then NODE_SRC="${NODE_MIRROR}"; else NODE_SRC="https://nodejs.org/dist"; fi \
    && curl -fsSL "${NODE_SRC}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.gz" \
        | tar -xz -C /usr/local --strip-components=1 \
    && corepack enable \
    && corepack prepare pnpm@11.8.0 --activate

# CI=true: 无 TTY 容器内 pnpm install 检测到 node_modules volume 与 lockfile
# 不匹配（如 watch rebuild 后 lockfile 更新）需清空重建时, 默认因无法交互
# 确认而 abort（ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY）。pnpm 11 已
# 移除 confirmModulesPurge 配置通道, 官方做法是设 CI=true 启用 CI 默认值
# （跳过交互确认）。副作用: install 走 frozen-lockfile 语义, lockfile 与
# package.json 不一致时失败——正是期望信号（该由 watch rebuild 处理）。
ENV CI=true

# Configure npm/pnpm registry (CN_MIRROR only — default is registry.npmjs.org).
RUN if [ "$CN_MIRROR" = "true" ]; then \
        npm config set registry "${NPM_REGISTRY}" \
        && pnpm config set registry "${NPM_REGISTRY}"; \
    fi

# --- Rust: rsproxy mirror for rustup + cargo (CN_MIRROR only). ---
# RUSTUP_DIST_SERVER is not set as ENV because ENV cannot be conditional.
# It is exported inline in the rustup-download RUN below; all subsequent
# cargo commands read config.toml (or use the default crates.io).
RUN if [ "$CN_MIRROR" = "true" ]; then \
        mkdir -p /usr/local/cargo \
        && printf \
            '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
            '[source.crates-io]' \
            'replace-with = "rsproxy-sparse"' \
            '[source.rsproxy]' \
            "registry = \"${RS_PROXY}/crates.io-index\"" \
            '[source.rsproxy-sparse]' \
            "registry = \"sparse+${RS_PROXY}/index/\"" \
            '[net]' \
            'git-fetch-with-cli = true' \
            > /usr/local/cargo/config.toml; \
    fi

# 开发只需 wasm32 target（dx serve 原生编译 server + 交叉编译 wasm 前端）
# 必须预装 nightly：dx serve 用 `cargo +nightly rustc --unit-graph -Z unstable-options`
# 编 WASM 前端。镜像里没有 nightly 时，rustup 代理会在容器运行时自动安装——而
# RUSTUP_DIST_SERVER 只在构建期生效，运行时回退默认 static.rust-lang.org，直连极慢
# （实测 ~10KB/s），dx 卡在 banner 后像死住一样。--profile minimal 只装 cargo/rustc/std，
# dx 不需要 nightly 的 clippy/rustfmt/docs。
RUN if [ "$CN_MIRROR" = "true" ]; then \
        export RUSTUP_DIST_SERVER="${RS_PROXY}" \
        && export RUSTUP_UPDATE_ROOT="${RS_PROXY}/rustup"; \
    fi \
    && rustup target add wasm32-unknown-unknown \
    && rustup component add clippy rustfmt \
    && rustup toolchain install nightly --profile minimal \
    && rustup target add wasm32-unknown-unknown --toolchain nightly

# ── dx CLI（与生产 Dockerfile 一致，从 GitHub Releases 安装预编译二进制）──
ARG DX_VERSION=0.7.10
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64) DX_TRIPLET=x86_64-unknown-linux-gnu  DX_SHA256=4363e4ed2a3f1eb7f4d38d2d59aed59ce43271c44c16b425e92c89a64761fbe7 ;; \
        arm64) DX_TRIPLET=aarch64-unknown-linux-gnu DX_SHA256=8f1a17d3218700ffbe15e6540d936a178b2556fc801121a31082e3ba4ab9ef55 ;; \
        *) echo "unsupported arch: $ARCH" >&2; exit 1; \
    esac \
    && if [ "$CN_MIRROR" = "true" ]; then GH_PX="${GH_PROXY}"; else GH_PX=""; fi \
    && DX_URL="${GH_PX:+${GH_PX}/}https://github.com/DioxusLabs/dioxus/releases/download/v${DX_VERSION}/dx-${DX_TRIPLET}.tar.gz" \
    && curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors --retry-connrefused --continue-at - "${DX_URL}" -o /tmp/dx.tar.gz \
    && echo "${DX_SHA256}  /tmp/dx.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/dx.tar.gz -C /usr/local/bin \
    && rm /tmp/dx.tar.gz \
    && dx --version

# ── Tailwind CSS v4 standalone ──────────────────────────────────
ARG TAILWIND_VERSION=4.3.1
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64)  TW_ARCH=x64   ;; \
        arm64)  TW_ARCH=arm64 ;; \
        *) echo "unsupported arch: $ARCH" >&2; exit 1; \
    esac \
    && if [ "$CN_MIRROR" = "true" ]; then GH_PX="${GH_PROXY}"; else GH_PX=""; fi \
    && GH_URL="${GH_PX:+${GH_PX}/}https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_VERSION}/tailwindcss-linux-${TW_ARCH}" \
    && curl -fsSL -o /usr/local/bin/tailwindcss "${GH_URL}" \
    && chmod +x /usr/local/bin/tailwindcss

WORKDIR /build

# ── 源码快照 ────────────────────────────────────────────────────
# compose watch 模式：镜像内含构建时的源码快照（容器启动即有完整源码,
# 无 bind mount 竞态），运行时由 `docker compose watch` 增量 sync 覆盖。
# .dockerignore 排除 .git → 容器内 build.rs 的 git describe 回退 "unknown",
# 以及 docs/tests/scripts/（容器内无集成测试源码, cargo test 会跳过）。
COPY . /build
# Pre-populate dx 的 esbuild + wasm-bindgen 工具缓存（见 Makefile）。
# dx 硬编码 npmjs.org/github.com 下载这两个工具,国内直连慢/重置;build time 预缓存后
# dx 启动(serve/build)的 path.exists() 检查命中即跳过联网。DX_HOME 在镜像层,
# 不随 named volume 丢失,target/node_modules 由 compose named volume 跨重启缓存。
ENV DX_HOME=/usr/local/dx
RUN make esbuild-cache wasm-bindgen-cache

# 启动开发服务器：make dev 内含 pnpm install → build-libs → highlight-css
# → katex-css → tailwindcss → dx serve --interactive false。
# pnpm install 和 CSS 生成每次都执行（幂等，pnpm 有缓存秒完）。
CMD ["make", "dev"]
