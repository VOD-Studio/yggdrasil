{
  "name": "yggdrasil-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --sequential --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck && bun run typecheck:tooling && bun run typecheck:scripts",
    "typecheck:tooling": "tsc --project tsconfig.tooling.json",
    "typecheck:scripts": "tsc --project ../scripts/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build:release": "tsc --project tsconfig.build.json && bun run --filter '*' bundle"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "harfbuzzjs": "1.6.4",
    "playwright": "1.65.1",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "shared",
    "yggdrasil-core",
    "tiptap-editor",
    "codemirror-editor",
    "lightbox",
    "xterm-terminal"
  ],
  "patchedDependencies": {
    "@tiptap/markdown@3.34.0": "patches/@tiptap__markdown@3.34.0.patch"
  },
  "packageManager": "bun@1.4.4",
  "dependencies": {
    "katex": "^0.19.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
