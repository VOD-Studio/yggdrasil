{
  "name": "@yggdrasil/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun run icons:deps && vitest run",
    "test:watch": "bun run icons:deps && vitest",
    "motion-css": "bun scripts/generate-motion-css.ts",
    "code-themes": "bun scripts/generate-code-themes.ts",
    "icons": "bun run icons:deps && bun scripts/generate-icons.ts",
    "icons:deps": "bun install --cwd scripts --frozen-lockfile",
    "mermaid-font-metrics": "bun scripts/generate-mermaid-font-metrics.ts"
  }
}
