# =============================================================================
# Cross-build an amd64 image on an arm64 host WITHOUT QEMU.
#
# The whole point of this file: a native arm64 builder (Docker Desktop pinned to
# $BUILDPLATFORM) compiles an x86_64 server binary, then hands it to a
# linux/amd64 alpine image. No Rosetta, no QEMU TCG, no `cross` — those crash
# (rustc SIGSEGV under QEMU) and Rosetta is unavailable with Docker VMM.
#
# The build is split into TWO native-arm64 builder stages because the two
# toolchains it needs cannot live in one base image:
#
#   Stage A (frontend, rust:1.99-trixie / glibc)  — cargo-leptos + nightly wasm32.
#     Builds the WASM client + JS libs + syntax/katex/tailwind CSS.
#
#   Stage B (server, rust:1.99-alpine3.22 / musl) — the ONLY reliable zig
#     source in China is Alpine's apk (TUNA mirror). ziglang.org is unreachable,
#     GitHub Releases carries NO zig binaries, and every Chinese "ziglang"
#     mirror returns an HTML error page. Alpine's zig is dynamically linked to
#     musl+LLVM, so it cannot be copied into the glibc frontend stage — hence a
#     separate native-musl stage where zig runs in its home environment.
#     cargo-zigbuild uses zig as the x86_64-musl C+Rust linker, producing a
#     fully static ELF (aws-lc-sys / ring / libmimalloc-sys / zenwebp all
#     cross-compile via zig's bundled musl sysroot).
#
# Stage C is a linux/amd64 alpine stage that just COPYs the two artifacts.
# =============================================================================


# -----------------------------------------------------------------------------
# Stage A: frontend assets (glibc Trixie, native arm64)
# -----------------------------------------------------------------------------
# Trixie (Debian 13, glibc 2.41).
FROM --platform=$BUILDPLATFORM rust:1.99-trixie AS frontend

# Master switch for Chinese mirrors.
#   CN_MIRROR=false (default): use all upstream/official sources (fast on CI
#     runners outside China — GitHub runners are in the US/EU).
#   CN_MIRROR=true: route all downloads through Chinese mirrors (TUNA for
#     Debian/Alpine apt, rsproxy for Rust/crates.io, npmmirror for Node/npm,
#     gh-proxy for GitHub Releases). Pass via: --build-arg CN_MIRROR=true
# Individual mirror URLs are still ARG-overridable for custom mirrors.
ARG CN_MIRROR=false
# Exported as ENV so build recipes (make) can read $CN_MIRROR when needed.
ENV CN_MIRROR=${CN_MIRROR}

# Mirror URLs used WHEN CN_MIRROR=true (Chinese mirrors; left unused when
# CN_MIRROR=false, where all downloads hit upstream sources instead):
#   - Debian apt          -> TUNA (Tsinghua)
#   - Rust + crates.io    -> rsproxy (ByteDance)
#   - Bun + npm packages   -> npmmirror (Alibaba)
#   - GitHub Releases     -> gh-proxy (tailwindcss)
ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
ARG NPM_REGISTRY=https://registry.npmmirror.com
ARG RS_PROXY=https://rsproxy.cn
ARG GH_PROXY=https://gh-proxy.com

# --- Debian apt: rewrite sources to the TUNA mirror (CN_MIRROR only). ---
RUN if [ "$CN_MIRROR" = "true" ]; then \
        sed -i \
          -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
          -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          -e "s|http://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
          /etc/apt/sources.list.d/debian.sources; \
    fi

# Install system build tooling. Native dependencies are needed for:
#   - build-essential: AWS-LC's non-FIPS C build for native highlight-css;
#     it does not require OpenSSL, CMake or Go.
#   - cmake/clang/nasm/libssl-dev: libwebp (zenwebp), ring, syntect
#   - curl/gnupg/ca-certificates: download tooling
# (musl-tools / the x86_64 musl target are NOT needed here — the server
# binary is built in Stage B now; this stage only emits the WASM client.)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        clang \
        nasm \
        pkg-config \
        libssl-dev \
        brotli \
        ca-certificates \
        curl \
        gnupg \
        git \
    && rm -rf /var/lib/apt/lists/*

# --- Bun ---
# 官方 npm 包 @oven/bun-linux-<arch> 的 tgz 内只有单文件二进制，无需 Node.js 和 unzip。
# CN_MIRROR=true: 走 npmmirror；CN_MIRROR=false: 走 registry.npmjs.org。
ARG BUN_VERSION=1.4.4
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64)  BUN_ARCH=x64     ;; \
        arm64)  BUN_ARCH=aarch64 ;; \
        *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac \
    && if [ "$CN_MIRROR" = "true" ]; then BUN_REGISTRY="${NPM_REGISTRY}"; else BUN_REGISTRY="https://registry.npmjs.org"; fi \
    && curl -fsSL "${BUN_REGISTRY}/@oven/bun-linux-${BUN_ARCH}/-/bun-linux-${BUN_ARCH}-${BUN_VERSION}.tgz" \
        | tar -xz -C /usr/local/bin --strip-components=2 package/bin/bun \
    && bun --version

# Configure the npm registry for `bun install` (CN_MIRROR only — default is registry.npmjs.org).
# Bun reads ~/.npmrc; bun.lock records default-registry packages without a URL,
# so this redirects every dependency download.
RUN if [ "$CN_MIRROR" = "true" ]; then \
        echo "registry=${NPM_REGISTRY}" > /root/.npmrc; \
    fi

# --- Rust: rsproxy mirror for rustup + cargo (CN_MIRROR only). ---
# RUSTUP_DIST_SERVER is not set as ENV because ENV cannot be conditional.
# It is exported inline in the sole rustup-download RUN below; all subsequent
# cargo commands read config.toml (or use the default crates.io).
RUN if [ "$CN_MIRROR" = "true" ]; then \
        mkdir -p /usr/local/cargo \
        && printf \
            '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n\n[source.rsproxy-sparse]\nregistry = "sparse+%s/index/"\n' \
            "${RS_PROXY}" \
            > /usr/local/cargo/config.toml; \
    fi

# Release WASM is compiled with a pinned nightly (-Zbuild-std, panic=immediate-abort;
# see WASM_NIGHTLY in the Makefile). Keep this ARG in sync with that variable.
ARG WASM_NIGHTLY=nightly-2026-10-19

# The frontend stage only builds the WASM client bundle — it needs just the
# wasm32 target on the pinned nightly. (Server musl targets moved to Stage B.)
# RUSTUP_DIST_SERVER is exported inline (only rustup-download that needs it).
RUN if [ "$CN_MIRROR" = "true" ]; then \
        export RUSTUP_DIST_SERVER="${RS_PROXY}" \
        && export RUSTUP_UPDATE_ROOT="${RS_PROXY}/rustup"; \
    fi \
    && rustup toolchain install "$WASM_NIGHTLY" --profile minimal \
        --component rust-src --target wasm32-unknown-unknown

# --- cargo-leptos: 前端构建（wasm-bindgen、分包、CSS）。独立层，便于缓存。
# wasm_split_cli_support 换成分包合并补丁版（原因见 Makefile 的 CARGO_LEPTOS_INSTALL），
# rev 与 Makefile 的 WASM_SPLIT_REV 保持一致。 ---
ARG WASM_SPLIT_REV=8ca741dd3c1ca52231b6b8ec4bed23955e376cbd
RUN if [ "$CN_MIRROR" = "true" ]; then GH_PX="${GH_PROXY}"; else GH_PX=""; fi \
    && cargo install cargo-leptos --version 0.3.11 --locked \
        --config "patch.crates-io.wasm_split_cli_support.git=\"${GH_PX:+${GH_PX}/}https://github.com/VOD-Studio/wasm-split-prototype\"" \
        --config "patch.crates-io.wasm_split_cli_support.rev=\"${WASM_SPLIT_REV}\""

# --- Tailwind CSS v4: the standalone binary is distributed via GitHub
# Releases (~106 MB). ---
ARG TAILWIND_VERSION=4.3.3
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64)  TW_ARCH=x64   ;; \
        arm64)  TW_ARCH=arm64 ;; \
        *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
    esac \
    && if [ "$CN_MIRROR" = "true" ]; then GH_PX="${GH_PROXY}"; else GH_PX=""; fi \
    && GH_URL="${GH_PX:+${GH_PX}/}https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_VERSION}/tailwindcss-linux-${TW_ARCH}" \
    && curl -fsSL -o /usr/local/bin/tailwindcss "${GH_URL}" \
    && chmod +x /usr/local/bin/tailwindcss

WORKDIR /build

# Cache the bun workspace node_modules by copying only package manifests first.
# package.json declares `workspaces: ["*"]`, so every sub-package manifest is
# copied before `bun install --frozen-lockfile`, keeping this layer reusable until
# a manifest or the lockfile changes. The patches/ tree must be present too
# (@tiptap/markdown patchedDependencies entry → missing patch otherwise).
# bunfig.toml carries the release-age policy and `[run] bun = true`.
COPY libs/package.json libs/bunfig.toml libs/bun.lock libs/
COPY libs/patches/                         libs/patches/
COPY libs/shared/package.json             libs/shared/
COPY libs/tiptap-editor/package.json      libs/tiptap-editor/
COPY libs/codemirror-editor/package.json  libs/codemirror-editor/
COPY libs/lightbox/package.json           libs/lightbox/
COPY libs/xterm-terminal/package.json     libs/xterm-terminal/
COPY libs/mermaid-renderer/package.json   libs/mermaid-renderer/
COPY libs/yggdrasil-core/package.json     libs/yggdrasil-core/
RUN cd libs && bun install --frozen-lockfile

# Build-time git info, injected by the caller via --build-arg. `.dockerignore`
# excludes `.git/`, so build.rs can't run `git` inside the container — these
# ARGs are the only channel for git metadata to reach build.rs (it reads them
# via std::env::var, its first-precedence source). Defaults are empty so a
# bare `docker build` without args degrades to "unknown" gracefully (build.rs
# falls back to the git command, then "unknown").
#
# Each ARG → ENV pair is needed: ARG is only visible in Dockerfile RUN
# commands (and build.rs is invoked by cargo, not a RUN), so we export it as
# ENV for the cargo build step to inherit. Both default to empty; Makefile's
# docker/docker-amd64/docker-multiarch targets override them on the host.
ARG YGG_BUILD_GIT_DESCRIBE=""
ARG YGG_BUILD_GIT_HASH=""
ARG YGG_BUILD_GIT_COMMIT_DATE=""
ENV YGG_BUILD_GIT_DESCRIBE=${YGG_BUILD_GIT_DESCRIBE}
ENV YGG_BUILD_GIT_HASH=${YGG_BUILD_GIT_HASH}
ENV YGG_BUILD_GIT_COMMIT_DATE=${YGG_BUILD_GIT_COMMIT_DATE}

# Copy the rest of the source tree and build everything.
COPY . .

# Build the JS libs, syntax-highlight CSS, KaTeX CSS + fonts and Tailwind
# stylesheet. These steps produce the contents of the public/ directory.
# Shared with make build / build-linux via the build-assets target, so the
# pipeline cannot drift (katex-css was once missing here, which left math
# rendering as bare spans without KaTeX fonts).
# cache mount: highlight-css (cargo run --bin) 首次编译整棵 server-feature
# native 依赖;cargo-leptos 前端构建 (wasm32) 与 cargo doc (native) 复用同一 fe-target 卷
# (wasm32/host 子目录互不干扰)。registry/git 跨 stage 共享(crate 源码架构无关)。
# server stage 用独立 srv-target id,与 frontend 产物隔离(musl≠glibc)。
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=fe-target,target=/build/target,sharing=locked \
    make build-assets

# 用 cargo-leptos 构建分包前端（wasm/js/css → target/site，hash.txt → target/release）。
# make build-frontend 使用固定 nightly + build-std（见 Makefile 的 LEPTOS_WASM_ENV）。
# 发布的 musl 服务端由 server stage 构建。cache mount（fe-target）只在本 RUN 期间存在，
# 因此 hash.txt 在同一 RUN 内先拷到 /build/hash.txt，再由 build-release.ts 把
# target/site 与 hash.txt 装配进 /build/dist。
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=fe-target,target=/build/target,sharing=locked \
    make build-frontend && \
    cp target/release/hash.txt /build/hash.txt && \
    bun scripts/build-release.ts --out /build/dist --hash /build/hash.txt

# 生成带站点主题的 lib crate 文档，包含私有项，并提供 /doc 入口重定向。
# cargo doc 使用当前 stage 的宿主目标，与 server stage 的 musl 交叉构建独立。
# .dockerignore 排除了宿主 public/doc/；这里直接写入装配后的发布目录。
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=fe-target,target=/build/target,sharing=locked \
    make doc DOC_OUT=dist/public/doc

# 与本地发布共用预压缩规则；查找或压缩失败时立即终止构建。
RUN make precompress RELEASE_OUT=/build/dist

# 校验发布产物：清单摘要、hash.txt 指向的产物、分包清单闭包与 .br 旁车。
RUN bun scripts/build-release.ts --verify --out /build/dist


# -----------------------------------------------------------------------------
# Stage B: server binary (Alpine musl, native arm64)
#
# Alpine is the home environment for zig here: its apk package is the only
# China-reachable zig source, and it is dynamically linked to musl+LLVM so it
# can only run natively inside this musl stage. cargo-zigbuild drives zig as
# the x86_64-unknown-linux-musl C+Rust cross-linker; zig bundles its own musl
# sysroot, so aws-lc-sys / ring / libmimalloc-sys / zenwebp compile without any
# system cross-toolchain. The output is a fully static ELF dropped into a
# linux/amd64 alpine image by Stage C.
# -----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:1.99-alpine3.22 AS server

# ARGs don't carry across stages, so CN_MIRROR must be re-declared here.
ARG CN_MIRROR=false
ENV CN_MIRROR=${CN_MIRROR}
ARG RS_PROXY=https://rsproxy.cn

# TUNA mirror for apk (CN_MIRROR only); install zig (the cross-linker) plus the
# build tooling Alpine's C build scripts may invoke on the host (make/cc for
# proc-macros and build-script host binaries). zig itself provides the x86_64
# target compiler, including aws-lc-sys's non-FIPS cc-based build; no extra
# CMake, Go or OpenSSL package is needed for AWS-LC.
RUN if [ "$CN_MIRROR" = "true" ]; then \
        sed -i 's|dl-cdn.alpinelinux.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apk/repositories; \
    fi \
    && apk add --no-cache zig build-base musl-dev pkgconfig

# rsproxy mirror for rustup + cargo (CN_MIRROR only).
# RUSTUP_DIST_SERVER is not set as ENV because ENV cannot be conditional; it is
# exported inline in the rustup-download RUN below.
RUN if [ "$CN_MIRROR" = "true" ]; then \
        mkdir -p /usr/local/cargo \
        && printf \
            '[source.crates-io]\nreplace-with = "rsproxy-sparse"\n\n[source.rsproxy-sparse]\nregistry = "sparse+%s/index/"\n' \
            "${RS_PROXY}" \
            > /usr/local/cargo/config.toml; \
    fi

# The cross-compile target (the host target, aarch64-unknown-linux-musl, is
# already installed by the rust:1.99-alpine3.22 base image for build-scripts
# and proc-macros that run on the builder).
# RUSTUP_DIST_SERVER is exported inline (only rustup-download that needs it).
RUN if [ "$CN_MIRROR" = "true" ]; then \
        export RUSTUP_DIST_SERVER="${RS_PROXY}" \
        && export RUSTUP_UPDATE_ROOT="${RS_PROXY}/rustup"; \
    fi \
    && rustup target add x86_64-unknown-linux-musl

# cargo-zigbuild generates zig-cc wrapper scripts and points cargo's linker
# env at them, overriding the project .cargo/config.toml's `x86_64-linux-musl-gcc`
# linker (which does not exist here). Pure-Rust crate; builds cleanly on musl.
RUN cargo install cargo-zigbuild --version 0.23.0 --locked

# Same git build-args as Stage A (build.rs reads them via env).
ARG YGG_BUILD_GIT_DESCRIBE=""
ARG YGG_BUILD_GIT_HASH=""
ARG YGG_BUILD_GIT_COMMIT_DATE=""
ENV YGG_BUILD_GIT_DESCRIBE=${YGG_BUILD_GIT_DESCRIBE}
ENV YGG_BUILD_GIT_HASH=${YGG_BUILD_GIT_HASH}
ENV YGG_BUILD_GIT_COMMIT_DATE=${YGG_BUILD_GIT_COMMIT_DATE}

WORKDIR /build
COPY . .

# Cross-compile the static-linked server binary to x86_64-musl. .cross-out and
# the host `cross` toolchain are gone — the binary is produced entirely inside
# this container now, so `make docker-amd64` needs nothing on the host but
# Docker itself.
# cargo zigbuild 交叉编译 server 到 x86_64-musl。srv-target cache id 独立于
# frontend 的 fe-target(产物架构不同,混用会让 cargo 困惑)。registry/git 共享。
# erase_components 必须与前端 WASM 一致（见 .cargo/config.toml），这里显式给出，
# 不依赖 zigbuild 对 [build] rustflags 的合并方式。
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=srv-target,target=/build/target,sharing=locked \
    RUSTFLAGS="--cfg erase_components" \
    cargo zigbuild --release --locked --target x86_64-unknown-linux-musl --bin yggdrasil \
    && cp target/x86_64-unknown-linux-musl/release/yggdrasil /build/server


# -----------------------------------------------------------------------------
# Stage C: runtime — alpine + PostgreSQL client tools (linux/amd64)
#
# pg_dump/psql 是应用内备份/恢复功能的运行时依赖（scratch 没有它们，备份曾
# 回退到不可恢复的纯 SQL 导出）。服务器 PG 为 16，客户端包与其对齐。
# 该 stage 是 $TARGETPLATFORM(amd64)，apk add 在 Rosetta 下执行，仅解包无编译。
# reqwest 的 Rustls/AWS-LC 使用 rustls-platform-verifier 读取系统 CA，
# 因此运行时显式安装 ca-certificates（不再使用内嵌 webpki-roots）。
# -----------------------------------------------------------------------------
FROM alpine:3.22

RUN apk add --no-cache ca-certificates postgresql16-client

WORKDIR /app

# Copy the static x86_64 musl server binary and the bundled public assets.
COPY --from=server --chown=65534:65534 /build/server /app/server
COPY --from=frontend --chown=65534:65534 /build/dist/public /app/public
# 服务端启动时从可执行文件同目录读取 hash.txt，校验前端产物与二进制配套。
COPY --from=frontend --chown=65534:65534 /build/dist/hash.txt /app/hash.txt
COPY --from=frontend --chown=65534:65534 /build/uploads /app/uploads
COPY --from=frontend --chown=65534:65534 /build/backups /app/backups

# The app checks for DATABASE_URL on startup even though this image is intended
# to run without a real database. A placeholder is enough to let the server boot.
ENV DATABASE_URL=postgres://postgres:postgres@localhost:5432/yggdrasil
ENV LEPTOS_SITE_ROOT=/app/public
ENV IP=0.0.0.0
ENV PORT=3000
ENV RUST_LOG=info

USER 65534:65534

EXPOSE 3000

ENTRYPOINT ["/app/server"]
