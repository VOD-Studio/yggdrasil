[Unit]
Description=Kite public read-only music API for rua.plus
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/vod-studio/kite-server@sha256:6bd68f36e404482f7dc0c96f873ea554aba473aa5ba33f7b975f69479d7d0c6f
Pull=never
ContainerName=kite-public
Network=nginx-proxy
NetworkAlias=kite-public
User=65532
Group=65532
Secret=kite-auth-token,target=kite-auth-token,uid=65532,mode=0400
Secret=kite-public-signing-key,target=public-signing-key,uid=65532,mode=0400
Environment=KITE_SERVER_AUTH_TOKEN_FILE=/run/secrets/kite-auth-token
Environment=KITE_SERVER_HTTP_ADDR=127.0.0.1:3721
Environment=KITE_SERVER_GRPC_ADDR=127.0.0.1:3722
Environment=KITE_PUBLIC_ADDR=0.0.0.0:3723
Environment=KITE_PUBLIC_PLAYLISTS=3778678
Environment=KITE_PUBLIC_ORIGINS=https://rua.plus
Environment=KITE_PUBLIC_SIGNING_KEY_FILE=/run/secrets/public-signing-key
Environment=KITE_PUBLIC_TRUST_PROXY=true
ReadOnly=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
